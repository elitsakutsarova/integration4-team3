# Local dev (HTTP):
VITE_APP_ORIGIN=http://localhost:5173

# LAN + HTTPS for phone QR testing (recommended):
# VITE_ALLOW_LAN=true
# VITE_APP_ORIGIN=https://localhost:5173

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# From Supabase Dashboard → Project Settings → API Keys
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=eyJhbGci...   # Legacy tab → anon public

# Dev commands:
#   npm run dev              — HTTP on localhost:5173
#   npm run certs:generate   — create self-signed TLS cert (certs/dev-*.pem)
#   npm run dev:lan          — HTTPS on 0.0.0.0:5173 + LAN URLs for QR codes
#
# Phone testing: run dev:lan, open Profile → Scan QRs, scan with phone on same Wi‑Fi.
# Trust the dev certificate once on the phone, then scan again.

# Supabase setup:
# 1. Run supabase/users.sql
# 2. If upgrading: supabase/migrate-drop-legacy-sticker-tables.sql
# 3. Run supabase/stickers.sql
# 4. Auth redirect URLs: http://localhost:5173/auth/callback
#    (and https://YOUR_LAN_IP:5173/auth/callback when using dev:lan)
