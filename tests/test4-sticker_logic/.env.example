VITE_APP_ORIGIN=http://localhost:5173
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# From Supabase Dashboard → Project Settings → API Keys
# Use ONE of these (publishable is recommended on new projects):
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=eyJhbGci...   # Legacy tab → anon public

# Optional: if your profile table is not named "users"
# VITE_SUPABASE_USERS_TABLE=users

# Email confirmation (Supabase Dashboard):
# 1. Authentication → Providers → Email → enable "Confirm email"
# 2. Authentication → URL Configuration:
#    Site URL: http://localhost:5173
#    Redirect URLs: http://localhost:5173/auth/callback
# 3. Run supabase/users.sql in SQL Editor once
# 4. Run supabase/stickers.sql for physical QR → digital collectible stickers
# 5. If no email arrives: check spam; use "Resend confirmation email" on login;
#    Supabase free tier limits ~2 emails/hour per address
